
{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
        "identifier": "mysticalcraft:charred_tree_feature"
    },

    "base_block": ["minecraft:dirt"],

    "may_replace": ["minecraft:air"],

    "fancy_trunk": {
        "trunk_block": "mysticalcraft:charred_log",

        "trunk_height": {
            "base": 4,
            "variance": 9,
            "scale": 1
        },
        "trunk_width": 1,
        "width_scale": 1,

        "foliage_altitude_factor": 0.5,
        "branches": {
            "slope": 0.33,
            "density": 0.25,
            "min_altitude_factor": 0
        }
    },
    "fancy_canopy": {
        "height": 1,
        "radius": 1,
        "leaf_block": "minecraft:air"
    },
    "may_grow_on": [
    "minecraft:dirt",
    "minecraft:grass_block",
    "minecraft:farmland",
    "mysticalcraft:schorched_dirt"
    ]
  }
}