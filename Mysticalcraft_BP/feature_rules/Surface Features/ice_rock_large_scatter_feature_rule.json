{
  "format_version": "1.13.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "mysticalcraft:ice_rock_large_scatter_feature_rule",
      "places_feature": "mysticalcraft:ice_rock_large_random_feature"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "mysticalcraft:ice_plains"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "mysticalcraft:ice_dunes"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "mysticalcraft:glacial_mountains"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": 4,
      "coordinate_eval_order": "zxy",
      "x": "math.random(-256, 256)",
      "y": "q.heightmap(v.worldx, v.worldz) - math.random(12, 14)",
      "z": "math.random(-256, 256)"
    }
  }
}
