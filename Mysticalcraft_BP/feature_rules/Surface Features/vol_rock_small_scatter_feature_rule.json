{
  "format_version": "1.13.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "mysticalcraft:vol_rock_small_scatter_feature_rule",
      "places_feature": "mysticalcraft:vol_rock_small_random_feature"
    },
    "conditions": {
      "placement_pass": "surface_pass",
      "minecraft:biome_filter": [
        {
          "any_of": [
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "desert"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "mysticalcraft:schorched_plains"
            },
            {
              "test": "has_biome_tag",
              "operator": "==",
              "value": "mesa"
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": 6,
      "coordinate_eval_order": "zxy",
      "x": "math.random(-256, 256)",
      "y": "q.heightmap(v.worldx, v.worldz) - math.random(3, 5)",
      "z": "math.random(-256, 256)"
    }
  }
}
